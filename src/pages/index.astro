---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { getProjects } from '../lib';

const projects = await getProjects();
---

<Base>
  <section class="card hero">
    <span class="badge success"><span class="dot"></span>{site.role}</span>
    <h1>{site.headline}</h1>
    <p class="intro">{site.intro}</p>
    <div class="hero-actions">
      <a class="btn primary" href="#work">View case studies</a>
      <a class="btn" href="/about/">About me</a>
    </div>
  </section>

  <section id="work" class="card">
    <div class="card-head">
      <div class="t">
        <h2>Case studies</h2>
        {projects.length > 0 && <span class="badge">{projects.length}</span>}
      </div>
    </div>

    {
      projects.length === 0 ? (
        <div class="empty">
          <b>Case studies are on their way</b>
          <span>New projects are being written up. Check back soon.</span>
        </div>
      ) : (
        <div class="tbl" role="list">
          <div class="tr th" aria-hidden="true">
            <span>Project</span>
            <span>Methods</span>
            <span>Year</span>
            <span />
          </div>
          {projects.map((p) => (
            <a class="tr" href={`/work/${p.id}/`} role="listitem">
              <span class="proj">
                <b>
                  {p.data.title}
                  {p.data.draft && <span class="badge warn">Draft</span>}
                </b>
                <span class="sum">{p.data.summary}</span>
                <span class="ctx">{p.data.context}</span>
              </span>
              <span class="badges">
                {p.data.methods.slice(0, 3).map((m) => (
                  <span class="badge">{m}</span>
                ))}
              </span>
              <span class="year">{p.data.year}</span>
              <span class="go">
                <Icon name="right" />
              </span>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="card">
    <div class="card-head">
      <h2>How I work</h2>
      <a class="btn ghost" href="/about/">More about me <Icon name="right" /></a>
    </div>
    <div class="tiles">
      {
        site.approach.map((a, i) => (
          <div class="tile">
            <span class="label">0{i + 1}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(24px, 5vw, 48px);
  }
  .hero h1 {
    max-width: 22ch;
    font-size: clamp(28px, 4vw, 44px);
  }
  .intro {
    max-width: 60ch;
    color: var(--fg-3);
    font-size: 16px;
  }
  .hero-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  /* Projects list styled as a Backoffice table */
  .tbl {
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .tr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 220px) 48px 32px;
    gap: 16px;
    align-items: center;
    padding: 16px;
    border-bottom: 1px solid var(--line);
  }
  .tr:last-child {
    border-bottom: 0;
  }
  .tr:nth-child(odd):not(.th) {
    background: var(--zebra);
  }
  .th {
    padding-top: 10px;
    padding-bottom: 10px;
    background: var(--zebra);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--fg-4);
  }
  a.tr:hover {
    background: var(--accent-bg);
  }
  .proj {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .proj b {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-weight: 600;
    font-size: 15px;
    color: #000;
  }
  .sum {
    font-size: 14px;
    color: var(--fg-3);
  }
  .ctx {
    font-size: 12px;
    color: var(--fg-4);
  }
  .year {
    font-size: 14px;
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }
  .go {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--line-2);
    background: var(--card);
    color: var(--fg-2);
  }
  a.tr:hover .go {
    border-color: var(--accent);
    color: var(--accent-fg);
  }

  @media (max-width: 760px) {
    .th {
      display: none;
    }
    .tr {
      grid-template-columns: minmax(0, 1fr) 32px;
      gap: 10px 12px;
    }
    .proj {
      grid-column: 1 / -1;
    }
    .badges {
      grid-column: 1 / -1;
    }
    .year {
      grid-row: 3;
    }
  }
</style>
