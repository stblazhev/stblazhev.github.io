---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import ResearchLoop from '../components/ResearchLoop.astro';
import Highlights from '../components/Highlights.astro';
import { getProjects } from '../lib';

const projects = await getProjects();

// Part of the headline gets the purple highlighter stroke (site.headlineMark)
const [hBefore, hAfter] = site.headlineMark && site.headline.includes(site.headlineMark)
  ? site.headline.split(site.headlineMark)
  : [site.headline, ''];
const hasMark = hBefore !== site.headline || hAfter !== '';

const sections = [
  { id: 'intro', text: 'Intro' },
  ...(site.highlights.length ? [{ id: 'highlights', text: 'Highlights' }] : []),
  { id: 'work', text: 'Case studies' },
  { id: 'process', text: 'How I work' },
  ...(site.testimonials.length ? [{ id: 'references', text: 'References' }] : []),
];

const next = [
  { label: 'Meet me', title: 'About me', text: 'Experience, education and the tools I use.', href: '/about/' },
  { label: 'Say hello', title: 'Get in touch', text: 'Email or LinkedIn, whichever suits you.', href: 'contact' },
];

// Words that type themselves out after the name in the hero
const focus = site.domain.map((d) => d.toLowerCase());
---

<Base sections={sections} next={next}>
  <section id="intro" class="card hero" data-spot>
    <span class="spot" aria-hidden="true"></span>
    <span class="badge success"><span class="dot"></span>{site.role}</span>
    <h1>
      {hasMark ? (
        <>{hBefore}<span class="mark">{site.headlineMark}</span>{hAfter}</>
      ) : (
        site.headline
      )}
    </h1>
    <p class="by">
      {site.photo && <img class="me" src={site.photo} alt={site.name} width="40" height="40" />}
      <span>
        {site.displayName}
        {focus.length > 0 && (
          <span class="focus">
            {' '}· researching <span class="typed" data-words={JSON.stringify(focus)}>{focus[0]}</span>
          </span>
        )}
      </span>
    </p>
    <p class="intro">{site.intro}</p>
    {site.motto && <p class="motto">“{site.motto}”</p>}
    <div class="hero-actions">
      <a class="btn primary" href="#work">View case studies</a>
      {
        site.email && (
          <a class="btn" href={`mailto:${site.email}`} data-contact>
            <Icon name="mail" /> Get in touch
          </a>
        )
      }
    </div>
  </section>

  {
    site.highlights.length > 0 && (
      <section id="highlights" class="card">
        <div class="card-head">
          <div class="t">
            <h2>Highlights</h2>
            <span class="badge">{site.highlights.length}</span>
          </div>
          <span class="hl-hint">
            <Icon name="flip" size={14} /> Tap a card for the story behind the number
          </span>
        </div>
        <Highlights />
      </section>
    )
  }

  <section id="work" class="card">
    <div class="card-head">
      <div class="t">
        <h2>Case studies</h2>
        {projects.length > 0 && <span class="badge">{projects.length}</span>}
      </div>
    </div>

    {
      projects.length === 0 ? (
        <div class="empty">
          <b>Case studies are on their way</b>
          <span>New projects are being written up. Check back soon.</span>
        </div>
      ) : (
        <div class="tbl" role="list">
          <div class="tr th" aria-hidden="true">
            <span>Project</span>
            <span>Methods</span>
            <span>Year</span>
            <span />
          </div>
          {projects.map((p) => (
            <a class="tr" href={`/work/${p.id}/`} role="listitem">
              <span class="proj">
                <b>
                  {p.data.title}
                  {p.data.draft && <span class="badge warn">Draft</span>}
                </b>
                <span class="sum">{p.data.summary}</span>
                <span class="ctx">{p.data.context}</span>
              </span>
              <span class="badges">
                {p.data.methods.slice(0, 3).map((m) => (
                  <span class="badge">{m}</span>
                ))}
              </span>
              <span class="year">{p.data.year}</span>
              <span class="go">
                <Icon name="right" />
              </span>
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section id="process" class="card">
    <div class="card-head">
      <div class="t">
        <h2>How I work</h2>
        <span class="badge">Research loop</span>
      </div>
      <a class="btn ghost" href="/about/">More about me <Icon name="right" /></a>
    </div>
    <ResearchLoop />
  </section>

  {
    site.testimonials.length > 0 && (
      <section id="references" class="card">
        <div class="card-head">
          <div class="t">
            <h2>References</h2>
            <span class="badge">What colleagues say</span>
          </div>
        </div>
        <div class="quotes">
          {site.testimonials.map((t, i) => (
            <figure class="quote" data-reveal style={`transition-delay:${i * 110}ms`}>
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                {t.avatar && <img class="face" src={t.avatar} alt="" width="44" height="44" loading="lazy" />}
                <span class="who">
                  <b>{t.name}</b>
                  <span>{t.title}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )
  }
</Base>

<script>
  // Hero: the research topics type themselves out, one after another
  const el = document.querySelector<HTMLElement>('.typed');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(el.dataset.words ?? '[]');
    let w = 0;
    let i = words[0]?.length ?? 0;
    let deleting = true;
    const tick = () => {
      const word = words[w];
      if (deleting) {
        i--;
        if (i <= 0) {
          deleting = false;
          w = (w + 1) % words.length;
        }
      } else {
        i++;
        if (i >= words[w].length) {
          deleting = true;
          el.textContent = words[w];
          return setTimeout(tick, 2200);
        }
      }
      el.textContent = (deleting ? word : words[w]).slice(0, Math.max(0, i));
      setTimeout(tick, deleting ? 45 : 85);
    };
    setTimeout(tick, 2600);
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(24px, 5vw, 48px);
  }
  .hero h1 {
    max-width: 22ch;
    font-size: clamp(28px, 4vw, 44px);
  }
  /* Purple highlighter stroke that draws in under part of the headline */
  .mark {
    background: linear-gradient(transparent 62%, rgba(169, 31, 189, 0.2) 62%, rgba(169, 31, 189, 0.2) 92%, transparent 92%) no-repeat 0 0 / 100% 100%;
    animation: mark 1.1s 0.3s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  @keyframes mark {
    from {
      background-size: 0% 100%;
    }
  }
  .hl-hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--fg-4);
  }
  .by {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: -6px;
    font-weight: 500;
    color: var(--fg-2);
  }
  .me {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
    padding: 2px;
    background: var(--card);
  }
  .focus {
    color: var(--fg-4);
    font-weight: 400;
  }
  .typed {
    color: var(--pop-deep);
    font-weight: 500;
    border-right: 2px solid var(--pop);
    padding-right: 2px;
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      border-color: transparent;
    }
  }
  .intro {
    max-width: 60ch;
    color: var(--fg-3);
    font-size: 16px;
  }
  .motto {
    padding: 8px 14px;
    border-left: 3px solid var(--accent);
    background: var(--accent-bg);
    border-radius: 0 8px 8px 0;
    font-weight: 500;
    font-size: 14px;
  }

  .quotes {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap);
  }
  @media (min-width: 1200px) {
    .quotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .quote {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .quote.in:hover,
  .quote:not(.reveal):hover {
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(17, 24, 39, 0.07);
    transform: translateY(-3px);
    transition-delay: 0s !important;
  }
  .face {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .quote:hover .face {
    transform: rotate(-6deg) scale(1.08);
  }
  .quote blockquote {
    margin: 0;
    font-size: 14px;
    color: var(--fg-2);
  }
  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    line-height: 1.4;
  }
  .face {
    width: 44px;
    height: 44px;
    flex: none;
  }
  .quote .who {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .quote .who b {
    font-size: 14px;
    font-weight: 600;
  }
  .quote .who span {
    font-size: 12px;
    color: var(--fg-3);
  }
  .hero-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  /* Projects list styled as a Backoffice table */
  .tbl {
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .tr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 220px) 48px 32px;
    gap: 16px;
    align-items: center;
    padding: 16px;
    border-bottom: 1px solid var(--line);
  }
  .tr:last-child {
    border-bottom: 0;
  }
  .tr:nth-child(odd):not(.th) {
    background: var(--zebra);
  }
  .th {
    padding-top: 10px;
    padding-bottom: 10px;
    background: var(--zebra);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--fg-4);
  }
  a.tr:hover {
    background: var(--accent-bg);
  }
  .proj {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .proj b {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-weight: 600;
    font-size: 15px;
    color: #000;
  }
  .sum {
    font-size: 14px;
    color: var(--fg-3);
  }
  .ctx {
    font-size: 12px;
    color: var(--fg-4);
  }
  .year {
    font-size: 14px;
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }
  .go {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--line-2);
    background: var(--card);
    color: var(--fg-2);
  }
  .go :global(svg) {
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  a.tr:hover .go {
    border-color: var(--accent);
    background: var(--accent);
    color: #000;
  }
  a.tr:hover .go :global(svg) {
    transform: translateX(3px);
  }

  @media (max-width: 760px) {
    .th {
      display: none;
    }
    .tr {
      grid-template-columns: minmax(0, 1fr) 32px;
      gap: 10px 12px;
    }
    .proj {
      grid-column: 1 / -1;
    }
    .badges {
      grid-column: 1 / -1;
    }
    .year {
      grid-row: 3;
    }
  }
</style>
