---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getProjects } from '../lib';

const projects = await getProjects();
---

<Base>
  <section class="hero wrap">
    <p class="eyebrow">{site.role}</p>
    <h1>{site.headline}</h1>
    <p class="intro">{site.intro}</p>
  </section>

  <section id="work" class="section wrap">
    <div class="section-head">
      <h2>Selected work</h2>
      {projects.length > 0 && <p class="eyebrow">{projects.length} case {projects.length === 1 ? 'study' : 'studies'}</p>}
    </div>

    {
      projects.length === 0 ? (
        <p class="empty">Case studies are being written. Check back soon.</p>
      ) : (
        <ol class="work-list">
          {projects.map((p, i) => (
            <li>
              <a class="work-item" href={`/work/${p.id}/`}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <div class="work-text">
                  <p class="eyebrow">
                    {p.data.context} · {p.data.year}
                    {p.data.draft && <span class="draft">Draft</span>}
                  </p>
                  <h3>{p.data.title}</h3>
                  <p class="summary">{p.data.summary}</p>
                  <ul class="tags">
                    {p.data.methods.slice(0, 4).map((m) => (
                      <li>{m}</li>
                    ))}
                  </ul>
                </div>
                {p.data.cover ? (
                  <img class="thumb" src={p.data.cover} alt="" loading={i < 2 ? 'eager' : 'lazy'} />
                ) : (
                  <span class="arrow" aria-hidden="true">→</span>
                )}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>How I work</h2>
      <a class="eyebrow more" href="/about/">More about me →</a>
    </div>
    <ul class="approach">
      {
        site.approach.map((a) => (
          <li>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(48px, 10vw, 128px);
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .hero h1 {
    font-size: clamp(44px, 8vw, 104px);
    line-height: 1;
    max-width: 14ch;
    margin: 20px 0 32px;
  }
  .intro {
    font-size: clamp(18px, 2vw, 21px);
    color: var(--muted);
    max-width: 38em;
    margin: 0;
  }

  .empty {
    color: var(--muted);
    padding: 32px 0;
    margin: 0;
  }

  .work-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .work-list > li + li {
    border-top: 1px solid var(--line);
  }
  .work-item {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 24px;
    align-items: start;
    padding: 36px 0;
    text-decoration: none;
  }
  .num {
    font-size: 13px;
    color: var(--muted);
    padding-top: 4px;
    font-variant-numeric: tabular-nums;
  }
  .work-text h3 {
    font-size: clamp(28px, 3.6vw, 40px);
    margin: 10px 0 12px;
    transition: color 0.2s;
  }
  .work-item:hover h3 {
    color: var(--accent);
  }
  .summary {
    color: var(--muted);
    margin: 0 0 16px;
    max-width: 40em;
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    font-size: 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 12px;
    color: var(--muted);
  }
  .draft {
    margin-left: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 4px;
    padding: 2px 6px;
  }
  .arrow {
    font-size: 28px;
    color: var(--muted);
    padding-top: 28px;
    transition: transform 0.2s, color 0.2s;
  }
  .work-item:hover .arrow {
    transform: translateX(6px);
    color: var(--accent);
  }
  .thumb {
    width: clamp(160px, 26vw, 320px);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--line);
  }

  .more {
    text-decoration: none;
  }
  .approach {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    padding-top: 32px;
  }
  .approach h3 {
    font-size: 26px;
    margin-bottom: 10px;
  }
  .approach p {
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 760px) {
    .work-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 28px 0;
    }
    .num,
    .arrow {
      display: none;
    }
    .thumb {
      width: 100%;
      order: -1;
    }
    .approach {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
