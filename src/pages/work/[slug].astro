---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const sections = [
  { id: 'overview', text: 'Overview' },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
];

const meta = [
  { label: 'Role', value: data.role, icon: 'idcard' as const },
  { label: 'Timeline', value: data.timeline, icon: 'clock' as const },
  { label: 'Team', value: data.team, icon: 'users' as const },
  { label: 'Year', value: data.year, icon: 'calendar' as const },
].filter((m) => m.value);

// Header visual: the study's preview screens, at full size (the home page uses small thumbs)
const screens = (data.preview ?? []).slice(0, 3).map((src) => src.replace('/thumbs/', '/screens/'));

// TL;DR as a three-step story when it has exactly three points
const steps =
  data.tldr.length === 3
    ? [
        { label: 'The problem', icon: 'alert' as const },
        { label: 'What I did', icon: 'pen' as const },
        { label: 'What changed', icon: 'trend' as const },
      ]
    : data.tldr.map((_, i) => ({ label: `Point ${i + 1}`, icon: 'right' as const }));
---

<Base title={data.title} description={data.summary} image={data.cover} sections={sections} back={{ href: '/#work', label: 'All case studies' }}>
  {
    data.draft && (
      <div class="page-head">
        <span class="badge warn">Draft: only visible locally</span>
      </div>
    )
  }

  <header id="overview" class:list={['card', 'head', { 'has-visual': screens.length > 0 }]} data-spot>
    <span class="spot" aria-hidden="true"></span>
    <div class="head-main">
      <div class="ctx">
        {data.context.split(' · ').map((c, i) => <span class:list={['ctx-chip', { first: i === 0 }]}>{c}</span>)}
      </div>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>

      <dl class="facts">
        {
          meta.map((m) => (
            <div class="fact">
              <span class="fact-ico" aria-hidden="true">
                <Icon name={m.icon} size={16} />
              </span>
              <span>
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </span>
            </div>
          ))
        }
      </dl>

      <div class="badges">
        {data.methods.map((m) => <span class="badge">{m}</span>)}
      </div>
    </div>

    {
      screens.length > 0 && (
        <div class="head-visual" aria-hidden="true">
          <div class="fan">
            {screens.map((src) => (
              <img src={src} alt="" width="540" height="1200" />
            ))}
          </div>
        </div>
      )
    }
  </header>

  {
    data.cover && (
      <div class="card cover-card">
        <img class="cover" src={data.cover} alt={data.coverAlt ?? ''} />
      </div>
    )
  }

  {
    data.outcomes.length > 0 && (
      <section class="card results" aria-label="Results">
        <ul class="tiles-r">
          {data.outcomes.map((o, i) => (
            <li class="r-tile" style={`--i:${i}`}>
              <b data-count>{o.value}</b>
              <span>{o.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    data.tldr.length > 0 && (
      <section class="card story" aria-labelledby="tldr-title">
        <div class="story-head">
          <h2 id="tldr-title">TL;DR</h2>
          <span class="muted">The study in {data.tldr.length === 3 ? 'three steps' : `${data.tldr.length} points`}</span>
        </div>
        <ol class="steps">
          {data.tldr.map((t, i) => (
            <li class="step" style={`--i:${i}`}>
              <span class="step-top">
                <span class="step-ico" aria-hidden="true">
                  <Icon name={steps[i].icon} size={18} />
                </span>
                <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              </span>
              <b class="step-label">{steps[i].label}</b>
              <p>{t}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <article class="card">
    <div class="prose">
      <Content />
    </div>
  </article>

  {
    next && next.id !== project.id && (
      <a class="card next" href={`/work/${next.id}/`}>
        <span>
          <span class="label">Next case study</span>
          <b>{next.data.title}</b>
        </span>
        <span class="btn primary">
          Open <Icon name="right" />
        </span>
      </a>
    )
  }

  <dialog class="viewer" id="viewer" aria-label="Screen viewer">
    <button class="btn ghost v-close" type="button" data-v-close aria-label="Close"><Icon name="close" /></button>
    <button class="btn v-nav v-prev" type="button" data-v-step="-1" aria-label="Previous screen"><Icon name="left" /></button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button class="btn v-nav v-next" type="button" data-v-step="1" aria-label="Next screen"><Icon name="right" /></button>
  </dialog>
</Base>

<script>
  // Galleries: drag to scroll with a mouse, faded ends that only show when there is more to
  // see, arrow buttons, position dots with a counter, and arrow keys when the gallery has focus.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const arrow = (d: string) =>
    `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${d}"/></svg>`;
  document.querySelectorAll<HTMLElement>('.prose .gallery').forEach((g, gi) => {
    const figs = [...g.querySelectorAll<HTMLElement>('figure')];
    if (figs.length < 2) return;
    const wrap = document.createElement('div');
    wrap.className = 'g-wrap';
    g.before(wrap);
    wrap.append(g);

    const prev = document.createElement('button');
    prev.type = 'button';
    prev.className = 'g-arrow g-prev';
    prev.setAttribute('aria-label', 'Previous screens');
    prev.innerHTML = arrow('M19 12H5M12 5l-7 7 7 7');
    const next = document.createElement('button');
    next.type = 'button';
    next.className = 'g-arrow g-next';
    next.setAttribute('aria-label', 'Next screens');
    next.innerHTML = arrow('M5 12h14M12 5l7 7-7 7');
    wrap.append(prev, next);

    const bar = document.createElement('div');
    bar.className = 'g-bar';
    const dots = document.createElement('div');
    dots.className = 'g-dots';
    const count = document.createElement('span');
    count.className = 'g-count';
    count.setAttribute('aria-live', 'polite');
    figs.forEach((f, i) => {
      const d = document.createElement('button');
      d.type = 'button';
      d.className = 'g-dot';
      const title = f.querySelector('figcaption b')?.textContent ?? `Screen ${i + 1}`;
      d.setAttribute('aria-label', `Show ${title}`);
      d.addEventListener('click', () => go(i));
      dots.append(d);
    });
    bar.append(dots, count);
    wrap.after(bar);

    const step = () => figs[1].offsetLeft - figs[0].offsetLeft;
    const go = (i: number) =>
      g.scrollTo({ left: figs[Math.max(0, Math.min(figs.length - 1, i))].offsetLeft - figs[0].offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
    const current = () => Math.round(g.scrollLeft / step());

    const update = () => {
      const max = g.scrollWidth - g.clientWidth - 2;
      g.classList.toggle('fade-l', g.scrollLeft > 2);
      g.classList.toggle('fade-r', g.scrollLeft < max);
      prev.hidden = g.scrollLeft <= 2;
      next.hidden = g.scrollLeft >= max;
      const first = current();
      const visible = Math.max(1, Math.floor((g.clientWidth + 16) / step()));
      const last = Math.min(figs.length, first + visible);
      [...dots.children].forEach((d, i) => d.setAttribute('aria-current', String(i >= first && i < last)));
      count.textContent =
        visible >= figs.length
          ? `${figs.length} screens`
          : last - first === 1
            ? `${first + 1} of ${figs.length}`
            : `${first + 1}–${last} of ${figs.length}`;
    };
    let raf = 0;
    g.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    }, { passive: true });
    addEventListener('resize', update);
    prev.addEventListener('click', () => g.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }));
    next.addEventListener('click', () => g.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }));
    g.addEventListener('keydown', (e) => {
      if (e.target !== g) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); go(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(current() - 1); }
      if (e.key === 'Home') { e.preventDefault(); go(0); }
      if (e.key === 'End') { e.preventDefault(); go(figs.length - 1); }
    });

    // Drag to scroll (mouse only; touch already scrolls natively)
    let startX = 0, startLeft = 0, dragged = false, down = false;
    g.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true;
      dragged = false;
      startX = e.clientX;
      startLeft = g.scrollLeft;
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (!dragged && Math.abs(dx) > 6) {
        dragged = true;
        g.classList.add('dragging');
      }
      if (dragged) g.scrollLeft = startLeft - dx;
    });
    addEventListener('pointerup', () => {
      if (!down) return;
      down = false;
      if (dragged) {
        const target = Math.round(g.scrollLeft / step());
        g.classList.remove('dragging');
        go(target);
      }
    });
    // A drag should not open the viewer
    g.addEventListener('click', (e) => {
      if (dragged) {
        e.stopPropagation();
        e.preventDefault();
        dragged = false;
      }
    }, true);
    g.querySelectorAll('img').forEach((img) => (img.draggable = false));

    update();

    // A small nudge the first time the first gallery comes into view, to show it scrolls
    if (gi === 0 && !reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(([en]) => {
        if (!en.isIntersecting) return;
        io.disconnect();
        if (g.scrollLeft > 2) return;
        g.scrollTo({ left: 64, behavior: 'smooth' });
        setTimeout(() => g.scrollTo({ left: 0, behavior: 'smooth' }), 650);
      }, { threshold: 0.6 });
      io.observe(g);
    }
  });

  // Screen viewer: any image in the case study opens full size. In a gallery,
  // arrows (buttons or keyboard) step through that gallery's screens.
  const viewer = document.getElementById('viewer') as HTMLDialogElement | null;
  if (viewer) {
    const vImg = viewer.querySelector('img')!;
    const vCap = viewer.querySelector('figcaption')!;
    let group: HTMLImageElement[] = [];
    let at = 0;
    const show = (i: number) => {
      at = (i + group.length) % group.length;
      const img = group[at];
      vImg.src = img.currentSrc || img.src;
      vImg.alt = img.alt;
      const cap = img.closest('figure')?.querySelector('figcaption');
      if (cap) vCap.innerHTML = cap.innerHTML; // our own markup: a bold title and a line of text
      else vCap.textContent = img.alt;
      viewer.classList.toggle('single', group.length < 2);
    };
    let opener: HTMLElement | null = null;
    const open = (img: HTMLImageElement) => {
      const gallery = img.closest('.gallery');
      group = gallery ? [...gallery.querySelectorAll<HTMLImageElement>('img')] : [img];
      opener = img;
      show(group.indexOf(img));
      viewer.showModal();
    };
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
      img.dataset.zoom = '';
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `Enlarge: ${img.alt}`);
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(img);
        }
      });
    });
    viewer.querySelectorAll<HTMLButtonElement>('[data-v-step]').forEach((b) =>
      b.addEventListener('click', () => show(at + Number(b.dataset.vStep))),
    );
    viewer.querySelector('[data-v-close]')!.addEventListener('click', () => viewer.close());
    viewer.addEventListener('click', (e) => {
      if (e.target === viewer) viewer.close();
    });
    viewer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(at + 1);
      if (e.key === 'ArrowLeft') show(at - 1);
    });
    viewer.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  /* ---------- Screen viewer ---------- */
  .viewer {
    width: min(96vw, 1100px);
    max-height: 94vh;
    padding: 20px 64px;
    border: 0;
    border-radius: 18px;
    background: #0b1216;
    color: #e5e7eb;
  }
  .viewer::backdrop {
    background: rgba(3, 10, 14, 0.78);
    backdrop-filter: blur(3px);
  }
  .viewer figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .viewer img {
    max-width: 100%;
    max-height: calc(94vh - 110px);
    width: auto;
    height: auto;
    border-radius: 16px;
  }
  .viewer figcaption {
    font-size: 14px;
    text-align: center;
    color: #d1d5db;
    max-width: 60ch;
  }
  .viewer figcaption :global(b) {
    display: block;
    color: #fff;
    font-weight: 600;
  }
  .v-close {
    position: absolute;
    top: 10px;
    right: 10px;
    color: #e5e7eb;
  }
  .v-close:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .v-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
  }
  .v-prev {
    left: 12px;
  }
  .v-next {
    right: 12px;
  }
  .viewer.single .v-nav {
    display: none;
  }
  @media (max-width: 600px) {
    .viewer {
      padding: 52px 12px 16px;
    }
    .v-nav {
      top: auto;
      bottom: 12px;
      transform: none;
    }
  }

  .page-head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---------- Header: text on the left, the study's screens fanned on the right ---------- */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    padding: clamp(24px, 4vw, 40px);
  }
  .head.has-visual {
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: center;
  }
  .head-main {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .ctx {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ctx-chip {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--zebra);
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-2);
  }
  .ctx-chip.first {
    border-color: var(--accent);
    background: var(--accent-bg);
    color: var(--accent-fg);
    font-weight: 600;
  }
  .head h1 {
    max-width: 24ch;
    font-size: clamp(26px, 3.4vw, 38px);
  }
  .lead {
    max-width: 62ch;
    font-size: 16px;
    color: var(--fg-2);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
    margin: 6px 0 0;
  }
  .fact {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }
  .fact-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--accent-bg);
    color: var(--accent-fg);
  }
  .fact dt {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .fact dd {
    margin: 2px 0 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--fg);
  }

  .head-visual {
    position: relative;
    align-self: stretch;
    min-height: 300px;
    border-radius: 16px;
    background:
      radial-gradient(circle, rgba(35, 122, 44, 0.16) 1.2px, transparent 1.6px) 0 0 / 16px 16px,
      linear-gradient(160deg, var(--accent-bg), #e3f9e3);
    overflow: hidden;
  }
  /* Fan centred in the panel; screens rotate around their bottom edge */
  .fan {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
  }
  .fan img {
    position: absolute;
    top: -156px;
    left: -70px;
    width: 140px;
    max-width: none;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 14px 30px rgba(17, 24, 39, 0.28);
    transform-origin: 50% 100%;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .fan img:nth-child(1) {
    transform: translateX(-84px) rotate(-10deg);
  }
  .fan img:nth-child(2) {
    z-index: 1;
    transform: translateY(-14px);
  }
  .fan img:nth-child(3) {
    transform: translateX(84px) rotate(10deg);
  }
  .head:hover .fan img:nth-child(1) {
    transform: translateX(-96px) rotate(-13deg);
  }
  .head:hover .fan img:nth-child(2) {
    transform: translateY(-24px) scale(1.04);
  }
  .head:hover .fan img:nth-child(3) {
    transform: translateX(96px) rotate(13deg);
  }
  /* The fan opens up once when the page loads */
  .fan img {
    animation: fan-in 0.8s 0.15s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  .fan img:nth-child(2) {
    animation-delay: 0.05s;
  }
  @keyframes fan-in {
    from {
      transform: translateY(60px) rotate(0deg);
      opacity: 0;
    }
  }

  .cover-card {
    padding: 0;
    overflow: hidden;
  }
  .cover {
    width: 100%;
  }

  /* ---------- Results: green tiles that pop in and count up ---------- */
  .results {
    padding: clamp(14px, 2.4vw, 20px);
  }
  .tiles-r {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .r-tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid #c9f3c9;
    border-radius: 14px;
    background:
      radial-gradient(circle, rgba(35, 122, 44, 0.12) 1px, transparent 1.4px) 0 0 / 14px 14px,
      linear-gradient(150deg, var(--accent-bg), #e9fbe9);
    animation: tile-in 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    animation-delay: calc(0.2s + var(--i) * 0.09s);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s;
  }
  .r-tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(41, 140, 51, 0.14);
  }
  .r-tile b {
    font-size: clamp(28px, 3.2vw, 38px);
    font-weight: 600;
    line-height: 1;
    color: var(--accent-fg);
    font-variant-numeric: tabular-nums;
  }
  .r-tile span {
    font-size: 13px;
    line-height: 1.4;
    color: var(--fg-2);
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.94);
    }
  }

  /* ---------- TL;DR: a three-step story ---------- */
  .story-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .story-head h2 {
    font-size: 18px;
  }
  .story-head .muted {
    font-size: 13px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    counter-reset: none;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 18px 20px;
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: 14px;
    background: var(--card);
    animation: step-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(0.45s + var(--i) * 0.12s);
  }
  .step:nth-child(1) {
    border-top-color: #f59e0b;
  }
  .step:nth-child(3) {
    border-top-color: var(--accent-fg);
  }
  /* Arrow joining the steps (desktop) */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -21px;
    width: 14px;
    height: 14px;
    border-top: 2px solid var(--line-2);
    border-right: 2px solid var(--line-2);
    transform: translateY(-50%) rotate(45deg);
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .step-ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--accent-bg);
    color: var(--accent-fg);
  }
  .step:nth-child(1) .step-ico {
    background: #fffbeb;
    color: #b45309;
  }
  .step-n {
    font-size: 26px;
    font-weight: 600;
    line-height: 1;
    color: var(--line-2);
    font-variant-numeric: tabular-nums;
  }
  .step-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg);
  }
