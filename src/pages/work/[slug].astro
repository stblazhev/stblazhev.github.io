---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../lib';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const sections = [
  { id: 'overview', text: 'Overview' },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
];

const meta = [
  { label: 'Role', value: data.role },
  { label: 'Timeline', value: data.timeline },
  { label: 'Team', value: data.team },
  { label: 'Year', value: data.year },
].filter((m) => m.value);
---

<Base title={data.title} description={data.summary} image={data.cover} sections={sections}>
  <div class="page-head">
    <a class="btn" href="/#work"><Icon name="back" /> All case studies</a>
    {data.draft && <span class="badge warn">Draft: only visible locally</span>}
  </div>

  <header id="overview" class="card head">
    <span class="ctx">{data.context}</span>
    <h1>{data.title}</h1>
    <p class="lead">{data.summary}</p>

    <dl class="meta">
      {
        meta.map((m) => (
          <div>
            <dt class="label">{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="badges">
      {data.methods.map((m) => <span class="badge">{m}</span>)}
    </div>
  </header>

  {
    data.cover && (
      <div class="card cover-card">
        <img class="cover" src={data.cover} alt={data.coverAlt ?? ''} />
      </div>
    )
  }

  {
    (data.outcomes.length > 0 || data.tldr.length > 0) && (
      <section class="card summary" aria-label="Summary">
        {data.outcomes.length > 0 && (
          <div class="kpis">
            {data.outcomes.map((o) => (
              <div class="kpi">
                <b>{o.value}</b>
                <span>{o.label}</span>
              </div>
            ))}
          </div>
        )}
        {data.tldr.length > 0 && (
          <div class="tldr">
            <h2>TL;DR</h2>
            <ul>
              {data.tldr.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )
  }

  <article class="card">
    <div class="prose">
      <Content />
    </div>
  </article>

  {
    next && next.id !== project.id && (
      <a class="card next" href={`/work/${next.id}/`}>
        <span>
          <span class="label">Next case study</span>
          <b>{next.data.title}</b>
        </span>
        <span class="btn primary">
          Open <Icon name="right" />
        </span>
      </a>
    )
  }
</Base>

<style>
  .page-head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 4vw, 40px);
  }
  .ctx {
    font-size: 13px;
    color: var(--fg-3);
  }
  .head h1 {
    max-width: 26ch;
  }
  .lead {
    max-width: 62ch;
    font-size: 16px;
    color: var(--fg-2);
  }
  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 16px;
    margin: 8px 0 0;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .meta dd {
    margin: 4px 0 0;
    font-size: 14px;
    font-weight: 500;
  }

  .cover-card {
    padding: 0;
    overflow: hidden;
  }
  .cover {
    width: 100%;
  }

  .summary {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .tldr {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 20px;
  }
  .tldr h2 {
    font-size: 15px;
  }
  .tldr ul {
    margin: 8px 0 0;
    padding-left: 1.2em;
    color: var(--fg-2);
  }
  .tldr li + li {
    margin-top: 6px;
  }

  .next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .next > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .next b {
    font-size: 17px;
    font-weight: 600;
  }
  .next:hover {
    border-color: var(--accent);
  }
</style>
