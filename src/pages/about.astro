---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import LearningMap from '../components/LearningMap.astro';

const kit = [
  { label: 'Methods', items: site.methods },
  { label: 'Tools', items: site.tools },
  { label: 'iGaming domain', items: site.domain },
  { label: 'Languages', items: site.languages },
].filter((k) => k.items.length > 0);

const sections = [
  { id: 'about-me', text: 'About me' },
  ...(site.experience.length ? [{ id: 'experience', text: 'Experience' }] : []),
  ...(site.education.length ? [{ id: 'education', text: 'Education' }] : []),
  { id: 'toolkit', text: 'Toolkit' },
];

const next = [
  { label: 'See the work', title: 'Case studies', text: 'How research turned into product decisions.', href: '/#work' },
  { label: 'Say hello', title: 'Get in touch', text: 'Email or LinkedIn, whichever suits you.', href: 'contact' },
];
---

<Base title="About" description={site.about[0]} sections={sections} next={next}>
  <section id="about-me" class="card intro" data-spot>
    <span class="spot" aria-hidden="true"></span>
    <div class="badges">
      <span class="badge success"><span class="dot"></span>{site.role}</span>
      {site.location && <span class="badge">{site.location}</span>}
    </div>
    <div class="name">
      {site.photo && <img class="me" src={site.photo} alt={site.name} width="72" height="72" />}
      <h1>{site.displayName}</h1>
    </div>
    <div class="bio">
      {site.about.map((p) => <p>{p}</p>)}
    </div>
    {
      (site.linkedin || site.email) && (
        <div class="actions">
          {site.linkedin && (
            <a class="btn primary" href={site.linkedin} rel="me">
              <Icon name="linkedin" /> LinkedIn
            </a>
          )}
          {site.email && (
            <a class="btn" href={`mailto:${site.email}`}>
              <Icon name="mail" /> Email me
            </a>
          )}
          {site.cv && (
            <a class="btn" href={site.cv}>
              <Icon name="file" /> CV
            </a>
          )}
        </div>
      )
    }
  </section>

  {
    site.experience.length > 0 && (
      <section id="experience" class="card">
        <div class="card-head">
          <h2>Experience</h2>
        </div>
        <ol class="tl" data-timeline>
          {site.experience.map((e) => {
            const now = /now|present/i.test(e.period);
            return (
              <li class:list={['tl-item', { now }]}>
                <span class="tl-dot" aria-hidden="true" />
                <div class="tl-card">
                  <div class="tl-top">
                    <span class="period">{e.period}</span>
                    {now && (
                      <span class="badge success live">
                        <span class="dot" />
                        Current role
                      </span>
                    )}
                  </div>
                  <b class="tl-role">{e.role}</b>
                  <span class="muted tl-co">{e.company}</span>
                  <p class="desc">{e.text}</p>
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  {
    site.education.length + site.courses.length > 0 && (
      <section id="education" class="card">
        <div class="card-head">
          <h2>Education</h2>
          <span class="muted pick">Pick a stop to see the details</span>
        </div>
        <LearningMap />
      </section>
    )
  }

  <section id="toolkit" class="card">
    <div class="card-head"><h2>Toolkit</h2></div>
    <div class="kit">
      {
        kit.map((k) => (
          <div>
            <p class="label">{k.label}</p>
            <div class="badges">
              {k.items.map((m) => (
                <span class="badge">{m}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<script>
  // Experience timeline: the green line grows as you read down the list,
  // and each dot lights up once the line reaches it.
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  if (tl) {
    const items = [...tl.querySelectorAll<HTMLElement>('.tl-item')];
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = tl.getBoundingClientRect();
      const fill = Math.min(1, Math.max(0, (window.innerHeight * 0.65 - r.top) / r.height));
      tl.style.setProperty('--fill', fill.toFixed(4));
      const reach = fill * r.height;
      items.forEach((li) => li.classList.toggle('lit', li.offsetTop + 22 <= reach + 1));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(24px, 5vw, 48px);
  }
  .name {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .me {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
    padding: 3px;
    background: var(--card);
  }
  .bio {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 66ch;
    font-size: 16px;
    color: var(--fg-2);
  }
  .actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* ---------- Experience timeline ---------- */
  .tl {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tl::before,
  .tl::after {
    content: '';
    position: absolute;
    left: 9px;
    top: 14px;
    bottom: 14px;
    width: 2px;
    border-radius: 2px;
    background: var(--line);
  }
  .tl::after {
    background: var(--accent);
    transform-origin: top;
    transform: scaleY(var(--fill, 1));
  }
  .tl-item {
    position: relative;
  }
  .tl-dot {
    position: absolute;
    left: -28px;
    top: 16px;
    z-index: 1;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--line-2);
    transition:
      border-color 0.3s,
      background 0.3s,
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .tl-item.lit .tl-dot {
    border-color: var(--accent-fg);
    background: var(--accent);
  }
  .tl-item:hover .tl-dot {
    transform: scale(1.3);
  }
  .tl-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    font-size: 14px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  .tl-item:hover .tl-card {
    border-color: var(--line-2);
    box-shadow: 0 8px 24px rgba(17, 24, 39, 0.06);
    transform: translateX(3px);
  }
  .tl-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .tl-role {
    font-size: 15px;
    font-weight: 600;
  }
  .tl-co {
    font-size: 13px;
  }
  .tl-card .desc {
    margin-top: 6px;
  }

  /* The current role stands out */
  .tl-item.now .tl-card {
    background: var(--accent-bg);
    border-color: var(--accent);
    padding: 18px 20px;
  }
  .tl-item.now .tl-role {
    font-size: 18px;
    color: #000;
  }
  .tl-item.now .tl-dot {
    width: 18px;
    height: 18px;
    left: -30px;
    border-color: var(--accent-fg);
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(107, 237, 106, 0.6);
    animation: ping 2s infinite;
  }
  .live .dot {
    animation: blink 1.6s infinite;
  }
  @keyframes ping {
    70% {
      box-shadow: 0 0 0 10px rgba(107, 237, 106, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(107, 237, 106, 0);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }

  .period {
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .desc {
    color: var(--fg-2);
  }

  .pick {
    font-size: 12px;
  }

  .kit {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .kit .label {
    margin-bottom: 8px;
  }

</style>
