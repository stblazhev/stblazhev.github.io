---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const kit = [
  { label: 'Methods', items: site.methods },
  { label: 'Tools', items: site.tools },
  { label: 'iGaming domain', items: site.domain },
  { label: 'Languages', items: site.languages },
].filter((k) => k.items.length > 0);

const sections = [
  { id: 'about-me', text: 'About me' },
  ...(site.experience.length ? [{ id: 'experience', text: 'Experience' }] : []),
  ...(site.education.length ? [{ id: 'education', text: 'Education' }] : []),
  { id: 'toolkit', text: 'Toolkit' },
];
---

<Base title="About" description={site.about[0]} sections={sections}>
  <section id="about-me" class="card intro">
    <div class="badges">
      <span class="badge success"><span class="dot"></span>{site.role}</span>
      {site.location && <span class="badge">{site.location}</span>}
    </div>
    <div class="name">
      {site.photo && <img class="me" src={site.photo} alt={site.name} width="72" height="72" />}
      <h1>{site.displayName}</h1>
    </div>
    <div class="bio">
      {site.about.map((p) => <p>{p}</p>)}
    </div>
    {
      (site.linkedin || site.email) && (
        <div class="actions">
          {site.linkedin && (
            <a class="btn primary" href={site.linkedin} rel="me">
              <Icon name="linkedin" /> LinkedIn
            </a>
          )}
          {site.email && (
            <a class="btn" href={`mailto:${site.email}`}>
              <Icon name="mail" /> Email me
            </a>
          )}
          {site.cv && (
            <a class="btn" href={site.cv}>
              <Icon name="file" /> CV
            </a>
          )}
        </div>
      )
    }
  </section>

  {
    site.experience.length > 0 && (
      <section id="experience" class="card">
        <div class="card-head">
          <h2>Experience</h2>
        </div>
        <div class="rows">
          {site.experience.map((e) => (
            <div class="row">
              <span class="period">{e.period}</span>
              <div class="what">
                <b>{e.role}</b>
                <span class="muted">{e.company}</span>
              </div>
              <p class="desc">{e.text}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    site.education.length > 0 && (
      <section id="education" class="card">
        <div class="card-head">
          <h2>Education</h2>
        </div>
        <div class="rows">
          {site.education.map((e) => (
            <div class="row edu">
              <span class="period">{e.period}</span>
              <div class="what">
                <b>{e.title}</b>
                <span class="muted">{e.place}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section id="toolkit" class="card">
    <div class="card-head"><h2>Toolkit</h2></div>
    <div class="kit">
      {
        kit.map((k) => (
          <div>
            <p class="label">{k.label}</p>
            <div class="badges">
              {k.items.map((m) => (
                <span class="badge">{m}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(24px, 5vw, 48px);
  }
  .name {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .me {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
    padding: 3px;
    background: var(--card);
  }
  .bio {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 66ch;
    font-size: 16px;
    color: var(--fg-2);
  }
  .actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .rows {
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 16px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }
  .row.edu {
    grid-template-columns: 160px minmax(0, 1fr);
  }
  .row:last-child {
    border-bottom: 0;
  }
  .row:nth-child(even) {
    background: var(--zebra);
  }
  .period {
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .what {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
  }
  .what b {
    font-weight: 600;
  }
  .what .muted {
    font-size: 13px;
  }
  .desc {
    color: var(--fg-2);
  }

  .kit {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .kit .label {
    margin-bottom: 8px;
  }

  @media (max-width: 760px) {
    .row,
    .row.edu {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
