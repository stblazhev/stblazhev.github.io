---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<Base title="About" description={site.about[0]}>
  <section class="card intro">
    <span class="badge success"><span class="dot"></span>{site.role}</span>
    <h1>{site.name}</h1>
    <div class="bio">
      {site.about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  {
    site.experience.length > 0 && (
      <section class="card">
        <div class="card-head">
          <h2>Experience</h2>
          {site.cv && (
            <a class="btn" href={site.cv}>
              <Icon name="file" /> Download CV
            </a>
          )}
        </div>
        <div class="rows">
          {site.experience.map((e) => (
            <div class="row">
              <span class="muted">{e.period}</span>
              <b>{e.role}</b>
              <span class="muted">{e.company}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="card">
    <div class="card-head"><h2>How I work</h2></div>
    <div class="tiles">
      {
        site.approach.map((a, i) => (
          <div class="tile">
            <span class="label">0{i + 1}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card">
    <div class="card-head"><h2>Toolkit</h2></div>
    <div class="kit">
      <div>
        <p class="label">Methods</p>
        <div class="badges">{site.methods.map((m) => <span class="badge">{m}</span>)}</div>
      </div>
      {
        site.tools.length > 0 && (
          <div>
            <p class="label">Tools</p>
            <div class="badges">
              {site.tools.map((t) => (
                <span class="badge">{t}</span>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: clamp(24px, 5vw, 48px);
  }
  .bio {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 64ch;
    font-size: 16px;
    color: var(--fg-2);
  }
  .rows {
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .row {
    display: grid;
    grid-template-columns: 160px 1fr 1fr;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
  }
  .row:last-child {
    border-bottom: 0;
  }
  .row:nth-child(even) {
    background: var(--zebra);
  }
  .row b {
    font-weight: 600;
  }
  .kit {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .kit .label {
    margin-bottom: 8px;
  }
  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
