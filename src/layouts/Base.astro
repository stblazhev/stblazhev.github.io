---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
const hasContact = Boolean(site.email || site.linkedin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="/">{site.name}</a>
      <nav aria-label="Main">
        <a href="/#work" aria-current={path.startsWith('/work') ? 'page' : undefined}>Work</a>
        <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        {hasContact && <a href="#contact">Contact</a>}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer id="contact" class="site-footer">
      <div class="wrap">
        {
          hasContact && (
            <div class="contact">
              <p class="eyebrow">Contact</p>
              <h2>Let’s talk research.</h2>
              <ul class="contact-links">
                {site.email && (
                  <li>
                    <a href={`mailto:${site.email}`}>{site.email}</a>
                  </li>
                )}
                {site.linkedin && (
                  <li>
                    <a href={site.linkedin} rel="me">LinkedIn</a>
                  </li>
                )}
                {site.cv && (
                  <li>
                    <a href={site.cv}>CV</a>
                  </li>
                )}
              </ul>
            </div>
          )
        }
        <p class="copyright">
          © {new Date().getFullYear()} {site.name}{site.location && ` · ${site.location}`}
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 24px;
    text-decoration: none;
    line-height: 1;
  }
  nav {
    display: flex;
    gap: clamp(16px, 3vw, 32px);
    font-size: 15px;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  .site-footer {
    padding: clamp(56px, 9vw, 112px) 0 40px;
    margin-top: clamp(56px, 9vw, 112px);
    border-top: 1px solid var(--line);
  }
  .contact h2 {
    font-size: clamp(40px, 7vw, 80px);
    margin: 12px 0 24px;
  }
  .contact-links {
    list-style: none;
    padding: 0;
    margin: 0 0 64px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    font-size: 18px;
  }
  .copyright {
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }
</style>
