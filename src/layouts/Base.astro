---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** "On this page" links shown in the side panel (case studies). */
  toc?: { slug: string; text: string }[];
}

const { title, description = site.description, image, toc = [] } = Astro.props;
const fullTitle = title ? `${title} · ${site.brand}` : `${site.brandFull} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
const hasContact = Boolean(site.email || site.linkedin);

const nav = [
  { href: '/', label: 'Work', icon: 'work' as const, on: path === '/' || path.startsWith('/work') },
  { href: '/about/', label: 'About', icon: 'user' as const, on: path.startsWith('/about') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="app">
      <aside class="side">
        <a class="who" href="/" aria-label={`${site.brandFull}, home`}>
          <span class="avatar" aria-hidden="true"><img src={site.logo} alt="" width="22" height="26" /></span>
          <span class="who-text">
            <b>{site.brand}</b>
            <span>{site.displayName}</span>
          </span>
        </a>

        <nav class="nav" aria-label="Main">
          {
            nav.map((n) => (
              <a class:list={['nav-item', { on: n.on }]} href={n.href} aria-current={n.on ? 'page' : undefined}>
                <Icon name={n.icon} />
                <span>{n.label}</span>
              </a>
            ))
          }
          {
            hasContact && (
              <a class="nav-item" href="#contact">
                <Icon name="mail" />
                <span>Contact</span>
              </a>
            )
          }
        </nav>

        {
          toc.length > 2 && (
            <nav class="toc" aria-label="On this page">
              <p class="label">On this page</p>
              {toc.map((h) => (
                <a href={`#${h.slug}`}>{h.text}</a>
              ))}
            </nav>
          )
        }

        {
          hasContact && (
            <div class="side-foot">
              {site.linkedin && (
                <a class="btn" href={site.linkedin} rel="me" aria-label="LinkedIn">
                  <Icon name="linkedin" />
                </a>
              )}
              {site.email && (
                <a class="btn" href={`mailto:${site.email}`} aria-label="Email">
                  <Icon name="mail" />
                </a>
              )}
              {site.cv && (
                <a class="btn" href={site.cv}>
                  <Icon name="file" /> CV
                </a>
              )}
            </div>
          )
        }
      </aside>

      <main id="main" class="main">
        <slot />

        {
          hasContact && (
            <section id="contact" class="card contact">
              <div>
                <h2>Let’s talk research</h2>
                <p class="muted">Open to conversations about UX research roles and projects.</p>
              </div>
              <div class="contact-actions">
                {site.email && (
                  <a class="btn primary" href={`mailto:${site.email}`}>
                    <Icon name="mail" /> {site.email}
                  </a>
                )}
                {site.linkedin && (
                  <a class="btn" href={site.linkedin} rel="me">
                    <Icon name="linkedin" /> LinkedIn
                  </a>
                )}
                {site.cv && (
                  <a class="btn" href={site.cv}>
                    <Icon name="file" /> CV
                  </a>
                )}
              </div>
            </section>
          )
        }

        <footer class="foot">
          {site.brand} © {new Date().getFullYear()} · Portfolio by {site.name}{site.location && ` · ${site.location}`}
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 16px;
    background: var(--fg);
    color: #fff;
    padding: 8px 12px;
    border-radius: 8px;
    z-index: 10;
  }

  .app {
    display: flex;
    gap: var(--gap);
    max-width: 1360px;
    margin: 0 auto;
    padding: var(--gap);
    min-height: 100vh;
  }

  /* Side panel: the Backoffice nav rail, expanded */
  .side {
    width: 248px;
    flex: none;
    position: sticky;
    top: var(--gap);
    height: calc(100vh - 2 * var(--gap));
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid var(--line);
  }
  .avatar {
    width: 44px;
    height: 40px;
    flex: none;
    border-radius: 12px;
    background: var(--soft);
    display: grid;
    place-items: center;
  }
  .avatar img {
    width: 22px;
    height: auto;
  }
  .who-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }
  .who-text b {
    font-weight: 600;
    font-size: 15px;
  }
  .who-text span {
    font-size: 12px;
    color: var(--fg-3);
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--navline);
    border-radius: 8px;
    color: var(--icon);
    font-size: 14px;
  }
  .nav-item span {
    color: var(--fg-2);
    font-weight: 500;
  }
  .nav-item:hover {
    background: var(--zebra);
  }
  .nav-item.on {
    background: var(--accent-bg);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .nav-item.on span {
    color: var(--fg);
    font-weight: 600;
  }

  .toc {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 12px 0;
    border-top: 1px solid var(--line);
    overflow-y: auto;
    min-height: 0;
    scrollbar-width: thin;
  }
  .toc .label {
    padding: 0 6px 6px;
  }
  .toc a {
    font-size: 13px;
    color: var(--fg-3);
    padding: 6px;
    border-radius: 6px;
    line-height: 1.35;
  }
  .toc a:hover {
    background: var(--zebra);
    color: var(--fg);
  }

  .side-foot {
    margin-top: auto;
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid var(--line);
  }

  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .contact .muted {
    margin-top: 4px;
    font-size: 14px;
  }
  .contact-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .foot {
    font-size: 12px;
    color: var(--fg-4);
    padding: 4px 4px 8px;
    margin-top: auto;
  }

  /* Phones and small tablets: the side panel becomes a top bar */
  @media (max-width: 900px) {
    .app {
      flex-direction: column;
    }
    .side {
      position: static;
      width: auto;
      height: auto;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }
    .who {
      border-bottom: 0;
      padding: 12px;
    }
    .nav {
      flex-direction: row;
      padding: 12px;
    }
    .nav-item {
      padding: 0 12px;
    }
    .toc,
    .side-foot {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .who-text span,
    .nav-item:not(.on) span {
      display: none;
    }
  }
</style>
