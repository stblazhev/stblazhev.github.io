---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Sections of this page, shown in the sticky section bar at the top. */
  // hint: a small pulsing purple dot that asks for a click; it hides while that section is active
  sections?: { id: string; text: string; hint?: boolean }[];
  /** "Where next?" tiles at the end of the page. href 'contact' opens the contact dialog. */
  next?: { label: string; title: string; text: string; href: string }[];
}

const { title, description = site.description, image, sections = [], next = [] } = Astro.props;
const fullTitle = title ? `${title} · ${site.brand}` : `${site.brandFull} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
const hasContact = Boolean(site.email || site.linkedin);

// The side nav only lists pages. Contact is an action (a dialog), not a page.
const nav = [
  { href: '/', label: 'Work', icon: 'work' as const, on: path === '/' || path.startsWith('/work') },
  { href: '/about/', label: 'About', icon: 'idcard' as const, on: path.startsWith('/about') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="app">
      <div class="rail">
      <aside class="side">
        <a class="who" href="/" aria-label={`${site.brandFull}, home`}>
          <img class="logo" src={site.logo} alt="" width="30" height="36" />
          <span class="who-text">
            <b>{site.brand}</b>
            <span>{site.displayName}</span>
          </span>
        </a>

        <nav class="nav" aria-label="Pages">
          {
            nav.map((n) => (
              <a class:list={['nav-item', { on: n.on }]} href={n.href} aria-current={n.on ? 'page' : undefined}>
                <Icon name={n.icon} />
                <span>{n.label}</span>
              </a>
            ))
          }
        </nav>

        {
          hasContact && (
            <div class="side-foot">
              <a class="btn pop talk" href={site.email ? `mailto:${site.email}` : site.linkedin} data-contact>
                <Icon name="chat" /> <span>Get in touch</span>
              </a>
            </div>
          )
        }
      </aside>
      </div>

      <main id="main" class="main">
        {
          sections.length > 1 && (
            <div class="secwrap">
              <nav class="secbar" aria-label="On this page">
                <div class="sec-track">
                  <span class="sec-ind" aria-hidden="true" />
                  {sections.map((s) => (
                    <a class="sec" href={`#${s.id}`} data-sec={s.id}>
                      {s.text}
                      {s.hint && <span class="sec-hint" aria-hidden="true" />}
                    </a>
                  ))}
                </div>
                <a class="sec-top" href="#main" aria-label="Back to top">
                  <Icon name="up" />
                </a>
                <span class="sec-progress" aria-hidden="true" />
              </nav>
            </div>
          )
        }

        <slot />

        {
          next.length > 0 && (
            <section class="card wn" aria-labelledby="wn-title">
              <h2 id="wn-title">Where next?</h2>
              <div class="wn-grid">
                {next.map((n) => {
                  const contact = n.href === 'contact';
                  if (contact && !hasContact) return null;
                  return (
                    <a
                      class:list={['wn-tile', { pop: contact }]}
                      href={contact ? `mailto:${site.email}` : n.href}
                      data-contact={contact ? '' : undefined}
                    >
                      <span class="label">{n.label}</span>
                      <b>{n.title}</b>
                      <span class="wn-text">{n.text}</span>
                      <span class="wn-go" aria-hidden="true">
                        <Icon name={contact ? 'chat' : 'right'} />
                      </span>
                    </a>
                  );
                })}
              </div>
            </section>
          )
        }

        <footer class="foot">
          {site.brand} © {new Date().getFullYear()} · Portfolio by {site.name}{site.location && ` · ${site.location}`}
        </footer>
      </main>
    </div>

    {
      hasContact && (
        <dialog class="contact" id="contact" aria-labelledby="contact-title">
          <div class="contact-head">
            <div>
              <h2 id="contact-title">Let’s talk research</h2>
              <p class="muted">Open to conversations about UX research roles and projects.</p>
            </div>
            <button class="btn ghost close" type="button" data-close aria-label="Close">
              <Icon name="close" />
            </button>
          </div>
          {site.email && (
            <div class="contact-row">
              <span class="contact-ico"><Icon name="mail" /></span>
              <span class="contact-val">
                <span class="label">Email</span>
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </span>
              <button class="btn copy" type="button" data-copy={site.email}>
                <Icon name="copy" /> <span>Copy</span>
              </button>
            </div>
          )}
          {site.linkedin && (
            <div class="contact-row">
              <span class="contact-ico"><Icon name="linkedin" /></span>
              <span class="contact-val">
                <span class="label">LinkedIn</span>
                <a href={site.linkedin} rel="me">{site.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>
              </span>
              <a class="btn" href={site.linkedin} rel="me">
                Open <Icon name="right" />
              </a>
            </div>
          )}
          {site.cv && (
            <a class="btn wide" href={site.cv}>
              <Icon name="file" /> Download CV
            </a>
          )}
          {site.email && (
            <a class="btn pop wide" href={`mailto:${site.email}`}>
              <Icon name="mail" /> Write an email
            </a>
          )}
        </dialog>
      )
    }
  </body>
</html>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Contact dialog ---------- */
  const dialog = document.querySelector<HTMLDialogElement>('dialog.contact');
  if (dialog && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLElement>('[data-contact]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // Click on the dimmed backdrop closes it
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
      b.addEventListener('click', async () => {
        const label = b.querySelector('span');
        try {
          await navigator.clipboard.writeText(b.dataset.copy ?? '');
          if (label) label.textContent = 'Copied';
          b.classList.add('done');
        } catch {
          if (label) label.textContent = 'Select and copy';
        }
        setTimeout(() => {
          if (label) label.textContent = 'Copy';
          b.classList.remove('done');
        }, 1800);
      }),
    );
  }

  /* ---------- Section bar: scroll spy, sliding indicator, progress ---------- */
  const bar = document.querySelector<HTMLElement>('.secbar');
  if (bar) {
    const track = bar.querySelector<HTMLElement>('.sec-track')!;
    const ind = bar.querySelector<HTMLElement>('.sec-ind')!;
    const top = bar.querySelector<HTMLElement>('.sec-top')!;
    const links = [...bar.querySelectorAll<HTMLAnchorElement>('.sec')];
    const targets = links.map((a) => document.getElementById(a.dataset.sec!));
    let current = -1;

    const place = (i: number) => {
      const a = links[i];
      ind.style.width = `${a.offsetWidth}px`;
      ind.style.transform = `translateX(${a.offsetLeft}px)`;
      // Keep the active chip visible when the bar scrolls sideways (phones)
      const l = a.offsetLeft - track.clientWidth / 2 + a.offsetWidth / 2;
      track.scrollTo({ left: l, behavior: reduce ? 'auto' : 'smooth' });
    };

    const update = () => {
      // A section counts as "current" once its top passes ~30% of the screen
      const line = Math.max(bar.getBoundingClientRect().bottom + 32, window.innerHeight * 0.3);
      let i = 0;
      targets.forEach((t, k) => {
        if (t && t.getBoundingClientRect().top <= line) i = k;
      });
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      if (max > 0 && window.scrollY >= max - 2) i = targets.length - 1;
      if (i !== current) {
        links.forEach((a, k) => (k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        place(i);
        current = i;
      }
      bar.style.setProperty('--p', String(max > 0 ? Math.min(1, window.scrollY / max) : 0));
      top.classList.toggle('show', window.scrollY > 400);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      if (current >= 0) place(current);
      onScroll();
    });
    document.fonts?.ready.then(() => current >= 0 && place(current));
    update();
    requestAnimationFrame(() => bar.classList.add('ready'));
  }

  /* ---------- Pointer glow on cards marked data-spot ---------- */
  if (window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${e.clientX - r.left}px`);
        el.style.setProperty('--my', `${e.clientY - r.top}px`);
        el.classList.add('lit');
      });
      el.addEventListener('pointerleave', () => el.classList.remove('lit'));
    });
  }

  /* ---------- Cards rise in as they enter the screen ---------- */
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        }),
      { rootMargin: '0px 0px -8% 0px' },
    );
    // Only things below the fold animate, so nothing on the first screen flickers.
    document.querySelectorAll('.main > .card, .main > section, [data-reveal]').forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight) return;
      el.classList.add('reveal');
      io.observe(el);
    });

    /* ---------- Numbers count up the first time they are seen ---------- */
    const counters = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          counters.unobserve(e.target);
          const el = e.target as HTMLElement;
          const m = (el.textContent ?? '').match(/^(\D*)(\d+(?:\.\d+)?)(.*)$/);
          if (!m) return;
          const [, pre, num, post] = m;
          const end = parseFloat(num);
          const dec = num.includes('.') ? num.split('.')[1].length : 0;
          const start = performance.now();
          const dur = 1200;
          const step = (now: number) => {
            const t = Math.min(1, (now - start) / dur);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = `${pre}${(end * eased).toFixed(dec)}${post}`;
            if (t < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }),
      { threshold: 0.6 },
    );
    document.querySelectorAll('.kpi b, [data-count]').forEach((el) => counters.observe(el));
  }
</script>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 16px;
    background: var(--fg);
    color: #fff;
    padding: 8px 12px;
    border-radius: 8px;
    z-index: 30;
  }

  .app {
    display: flex;
    gap: var(--gap);
    max-width: 1360px;
    margin: 0 auto;
    padding: var(--gap);
    min-height: 100vh;
  }

  /* Side panel: the Backoffice nav rail, expanded */
  .side {
    width: 248px;
    flex: none;
    position: sticky;
    top: var(--gap);
    height: calc(100vh - 2 * var(--gap));
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid var(--line);
  }
  .logo {
    width: 30px;
    height: auto;
    flex: none;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .who:hover .logo {
    transform: rotate(-12deg) scale(1.08);
  }
  .who-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }
  .who-text b {
    font-weight: 600;
    font-size: 15px;
  }
  .who-text span {
    font-size: 12px;
    color: var(--fg-3);
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--navline);
    border-radius: 8px;
    color: var(--icon);
    font-size: 14px;
  }
  .nav-item span {
    color: var(--fg-2);
    font-weight: 500;
  }
  .nav-item:hover {
    background: var(--zebra);
  }
  .nav-item.on {
    background: var(--accent-bg);
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .nav-item.on span {
    color: var(--fg);
    font-weight: 600;
  }

  .side-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    padding: 12px;
    border-top: 1px solid var(--line);
  }
  .talk {
    height: 40px;
  }

  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  /* ---------- Sticky section bar ---------- */
  .secwrap {
    position: sticky;
    top: 0;
    z-index: 20;
    margin-top: calc(-1 * var(--gap));
    padding-top: var(--gap);
    background: var(--bg);
  }
  .secbar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
  }
  .sec-track {
    position: relative;
    display: flex;
    gap: 4px;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .sec-track::-webkit-scrollbar {
    display: none;
  }
  .sec {
    position: relative;
    z-index: 1;
    flex: none;
    height: 34px;
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-3);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .sec:hover {
    color: var(--fg);
  }
  .sec[aria-current] {
    color: var(--fg);
    font-weight: 600;
  }
  /* Attention dot in the logo purple; sits in the corner so it never shifts the label */
  .sec-hint {
    position: absolute;
    top: 6px;
    right: 3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--pop);
    transition:
      opacity 0.25s,
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sec-hint::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--pop);
    animation: sec-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes sec-ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .sec[aria-current] .sec-hint {
    opacity: 0;
    transform: scale(0);
  }
  .sec-ind {
    position: absolute;
    left: 0;
    top: 0;
    height: 34px;
    width: 0;
    border-radius: 8px;
    background: var(--accent-bg);
    border: 1px solid var(--accent);
  }
  .secbar.ready .sec-ind {
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sec-top {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--line-2);
    color: var(--fg-2);
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .sec-top.show {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .sec-top:hover {
    border-color: var(--accent);
    color: var(--accent-fg);
  }
  .sec-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  /* ---------- Contact dialog ---------- */
  .contact {
    width: min(460px, calc(100vw - 32px));
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    box-shadow: 0 24px 60px rgba(17, 24, 39, 0.18);
    color: var(--fg);
    background: var(--card);
  }
  .contact[open] {
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: pop 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .contact::backdrop {
    background: rgba(17, 24, 39, 0.35);
    backdrop-filter: blur(3px);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
    }
  }
  .contact-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
  }
  .contact-head .muted {
    margin-top: 4px;
    font-size: 14px;
  }
  .close {
    width: 36px;
    padding: 0;
    flex: none;
  }
  .contact-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .contact-ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 8px;
    background: var(--accent-bg);
    color: var(--accent-fg);
  }
  .contact-val {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
    line-height: 1.35;
  }
  .contact-val a {
    font-size: 14px;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .contact-val a:hover {
    color: var(--accent-fg);
  }
  .copy.done {
    border-color: var(--accent);
    background: var(--accent-bg);
    color: var(--accent-fg);
  }
  .wide {
    width: 100%;
    height: 42px;
    margin-top: 4px;
  }

  /* ---------- Where next? ---------- */
  .wn h2 {
    margin-bottom: 14px;
  }
  .wn-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--gap);
  }
  .wn-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 64px 18px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }
  .wn-tile b {
    font-size: 17px;
    font-weight: 600;
    color: #000;
  }
  .wn-text {
    font-size: 13px;
    color: var(--fg-3);
  }
  .wn-go {
    position: absolute;
    right: 16px;
    top: 50%;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-top: -18px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    color: var(--fg-2);
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .wn-tile:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(17, 24, 39, 0.07);
    transform: translateY(-2px);
  }
  .wn-tile:hover .wn-go {
    transform: translateX(4px);
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }
  .wn-tile.pop {
    background: var(--pop-bg);
    border-color: var(--pop-line);
  }
  .wn-tile.pop .label {
    color: var(--pop);
  }
  .wn-tile.pop:hover {
    border-color: var(--pop);
  }
  .wn-tile.pop:hover .wn-go {
    background: var(--pop-bg);
    border-color: var(--pop);
    color: var(--pop-deep);
    transform: rotate(-12deg) scale(1.08);
  }

  .foot {
    font-size: 12px;
    color: var(--fg-4);
    padding: 4px 4px 8px;
    margin-top: auto;
  }

  /* Phones and small tablets: the side panel becomes a top bar */
  @media (max-width: 900px) {
    .app {
      flex-direction: column;
    }
    .side {
      position: static;
      width: auto;
      height: auto;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
    .who {
