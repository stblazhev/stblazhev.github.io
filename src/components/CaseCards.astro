---
// Home page case studies as compact rows: a small result tile, then year and read time,
// title, a two-line summary and methods, a fan of phone screens that spreads out on hover
// (desktop), and an arrow. "Quick look" opens the study's TL;DR and numbers in place.
// The last row is the purple "Brewing new ideas" placeholder.
// Accessibility: the title is the link (stretched over the row); "Quick look" is a separate
// button with aria-expanded, and the closed panel is inert so it stays out of the tab order.
import Icon from './Icon.astro';
import { site } from '../data/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;

const minutes = (body = '') => {
  const text = body.replace(/!\[[^\]]*\]\([^)]*\)/g, '').replace(/<[^>]+>/g, '');
  return Math.max(1, Math.round((text.match(/\w+/g) ?? []).length / 230));
};
const bubbles = Array.from({ length: 8 }, (_, i) => i);
---

<ul class="cs-list">
  {
    projects.map((p, i) => {
      const kpi = p.data.outcomes[0];
      const qid = `cs-${p.id}-q`;
      const preview = p.data.preview ?? [];
      return (
        <li class="cs-item" data-reveal style={`transition-delay:${i * 90}ms`}>
          <div class="cs" data-spot>
            <span class="spot" aria-hidden="true" />
            {kpi && (
              <span class="cs-kpi" id={`cs-${p.id}-k`}>
                <b data-count>{kpi.value}</b>{' '}
                <span>{kpi.label}</span>
              </span>
            )}
            <span class="cs-body">
              <span class="cs-meta">
                {p.data.year} · {minutes(p.body)} min read
                {p.data.draft && <span class="badge warn">Draft</span>}
              </span>
              <h3 class="cs-title">
                <a
                  class="cs-link"
                  href={`/work/${p.id}/`}
                  aria-describedby={kpi ? `cs-${p.id}-k` : undefined}
                  data-goatcounter-click={`case-study-${p.id}`}
                  data-goatcounter-title={`Open case study: ${p.data.title}`}
                >
                  {p.data.title}
                </a>
              </h3>
              <span class="cs-sum">{p.data.summary}</span>
              <span class="cs-foot">
                <span class="badges cs-methods">
                  {p.data.methods.slice(0, 3).map((m) => (
                    <span class="badge">{m}</span>
                  ))}
                </span>
                {(p.data.tldr.length > 0 || p.data.outcomes.length > 1) && (
                  <button
                    class="cs-quick-btn"
                    type="button"
                    aria-expanded="false"
                    aria-controls={qid}
                    data-quick
                    data-goatcounter-click={`quick-look-${p.id}`}
                    data-goatcounter-title={`Quick look: ${p.data.title}`}
                  >
                    <Icon name="list" size={14} /> Quick look
                  </button>
                )}
              </span>
            </span>
            {preview.length > 0 && (
              <span class="cs-peek" aria-hidden="true">
                {preview.slice(0, 3).map((src) => (
                  <img src={src} alt="" width="180" height="400" loading="lazy" />
                ))}
              </span>
            )}
            <span class="cs-go" aria-hidden="true">
              <Icon name="right" />
            </span>
          </div>

          <div class="cs-quick" id={qid} inert>
            <div class="cs-quick-in">
              {p.data.outcomes.length > 0 && (
                <ul class="q-nums">
                  {p.data.outcomes.map((o) => (
                    <li>
                      <b>{o.value}</b>
                      <span>{o.label}</span>
                    </li>
                  ))}
                </ul>
              )}
              {p.data.tldr.length > 0 && (
                <ul class="q-tldr">
                  {p.data.tldr.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              )}
              {preview.length > 0 && (
                <span class="q-screens" aria-hidden="true">
                  {preview.slice(0, 3).map((src) => (
                    <img src={src} alt="" width="180" height="400" loading="lazy" />
                  ))}
                </span>
              )}
              <a class="btn primary q-open" href={`/work/${p.id}/`} data-goatcounter-click={`quick-look-open-${p.id}`}>
                Read the case study <Icon name="right" />
              </a>
            </div>
          </div>
        </li>
      );
    })
  }

  <li data-reveal>
    <div class="cs cs-brew" role="note" aria-label="Brewing new ideas: the next case study is on its way">
      <span class="cs-kpi brew-art" aria-hidden="true">
        <span class="flask">
          {bubbles.map((b) => <i class="bubble" style={`--b:${b}`} />)}
          <img src={site.logo} alt="" width="40" height="48" />
        </span>
      </span>
      <span class="cs-body">
        <span class="cs-meta"><span class="badge pop">In progress</span></span>
        <h3 class="cs-title">
          Brewing new ideas<span class="dots" aria-hidden="true"><i>.</i><i>.</i><i>.</i></span>
        </h3>
        <span class="cs-sum">The next case study is being written up. Check back soon.</span>
        <span class="brew-bar" aria-hidden="true"><span /></span>
      </span>
    </div>
  </li>
</ul>

<script>
  // Quick look: open and close the TL;DR panel under a row
  document.querySelectorAll<HTMLButtonElement>('[data-quick]').forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute('aria-controls')!)!;
    const item = btn.closest('.cs-item')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      item.classList.toggle('open', open);
      panel.toggleAttribute('inert', !open);
    });
  });
</script>

<style>
  .cs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
  .cs-list > li {
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ---------- Row ---------- */
  .cs {
    position: relative;
    display: grid;
    grid-template-columns: 196px minmax(0, 1fr) 150px 40px;
    align-items: center;
    gap: 20px;
    padding: 12px 16px 12px 12px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
    transition:
      border-color 0.2s,
      box-shadow 0.25s,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 0.2s;
  }
  .cs-item .cs:hover,
  .cs-item .cs:focus-within {
    border-color: var(--accent);
    box-shadow: 0 10px 28px rgba(17, 24, 39, 0.08);
    transform: translateY(-2px);
  }
  /* The title link covers the whole row, so the row is one big target. The body must not be
     a positioning context (the global glow rule makes card children relative), and the glow
     sits behind the content inside the row's own stacking context. */
  .cs-item .cs {
    isolation: isolate;
  }
  .cs-item .cs > .cs-body {
    position: static;
  }
  .cs-item .cs > .spot {
    z-index: -1;
  }
  .cs-link {
    color: inherit;
  }
  .cs-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 14px;
  }
  .cs-link:focus-visible {
    outline: none;
  }
  .cs-link:focus-visible::after {
    outline: 2px solid var(--accent-fg);
    outline-offset: 3px;
  }

  /* Small result tile: the headline number and what it means */
  .cs-kpi {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    min-height: 112px;
    padding: 14px 16px;
    border-radius: 10px;
    background:
      radial-gradient(circle, rgba(35, 122, 44, 0.14) 1.1px, transparent 1.5px) 0 0 / 14px 14px,
      linear-gradient(135deg, var(--accent-bg), #e9fbe9);
    transition: background-position 0.8s ease;
  }
  .cs-item .cs:hover .cs-kpi {
    background-position:
      7px -7px,
      0 0;
  }
  .cs-kpi b {
    font-size: 32px;
    font-weight: 600;
    line-height: 1;
    color: var(--accent-fg);
    font-variant-numeric: tabular-nums;
  }
  .cs-kpi span {
    font-size: 12px;
    line-height: 1.4;
    color: var(--fg-2);
  }

  .cs-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .cs-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--fg-3);
  }
  .cs-title {
    font-size: 16px;
    line-height: 1.35;
    color: #000;
  }
  .cs-sum {
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cs-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 2px;
  }
  /* Sits above the stretched link so it can be clicked on its own */
  .cs-quick-btn {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--card);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-2);
    cursor: pointer;
    transition:
      border-color 0.2s,
      background 0.2s,
      color 0.2s;
  }
  .cs-quick-btn:hover {
    border-color: var(--accent);
    background: var(--accent-bg);
    color: var(--fg);
  }
  .cs-item.open .cs-quick-btn {
    border-color: var(--accent-fg);
    background: var(--accent-bg);
    color: var(--accent-fg);
  }

  /* Screen peek: three phone screens stacked like cards that fan out on hover */
  .cs-peek {
    position: relative;
    align-self: stretch;
    min-height: 120px;
  }
  .cs-peek img {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 52px;
    height: auto;
    margin-left: -26px;
    border-radius: 8px;
    box-shadow: 0 6px 16px rgba(17, 24, 39, 0.22);
    transform-origin: 50% 100%;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cs-peek img:nth-child(1) {
    transform: translateX(-12px) rotate(-7deg);
  }
  .cs-peek img:nth-child(2) {
    z-index: 1;
    transform: translateY(-4px);
  }
  .cs-peek img:nth-child(3) {
    transform: translateX(12px) rotate(7deg);
  }
  .cs-item .cs:hover .cs-peek img:nth-child(1),
  .cs-item .cs:focus-within .cs-peek img:nth-child(1) {
    transform: translateX(-46px) rotate(-10deg);
  }
  .cs-item .cs:hover .cs-peek img:nth-child(2),
  .cs-item .cs:focus-within .cs-peek img:nth-child(2) {
    transform: translateY(-10px) scale(1.08);
  }
  .cs-item .cs:hover .cs-peek img:nth-child(3),
  .cs-item .cs:focus-within .cs-peek img:nth-child(3) {
    transform: translateX(46px) rotate(10deg);
  }

  .cs-go {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-2);
    color: var(--fg-2);
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .cs-go :global(svg) {
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .cs-item .cs:hover .cs-go,
  .cs-item .cs:focus-within .cs-go {
    background: var(--accent);
    border-color: var(--accent);
    color: #000;
  }
  .cs-item .cs:hover .cs-go :global(svg) {
    transform: translateX(3px);
  }

  /* ---------- Quick look panel ---------- */
  .cs-quick {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cs-item.open .cs-quick {
    grid-template-rows: 1fr;
  }
  .cs-quick-in {
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 14px 24px;
    padding: 0 18px;
    margin: 0 10px;
    border: 1px solid transparent;
    border-top: 0;
    border-radius: 0 0 14px 14px;
    background: var(--zebra);
    transition:
      padding 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s;
  }
  .cs-item.open .cs-quick-in {
    padding: 16px 18px 18px;
    border-color: var(--line);
  }
  .q-nums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    align-content: start;
  }
  .q-nums li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--card);
  }
  .q-nums b {
    font-size: 20px;
    font-weight: 600;
    color: var(--accent-fg);
    line-height: 1.1;
  }
  .q-nums span {
    font-size: 12px;
    line-height: 1.35;
    color: var(--fg-3);
  }
  .q-tldr {
    margin: 0;
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fg-2);
  }
  .q-tldr li::marker {
    color: var(--accent-fg);
  }
  .q-screens {
    display: none;
  }
  .q-open {
    grid-column: 1 / -1;
    justify-self: start;
  }

  /* ---------- Narrower screens: no fan; phones: tile on top as a slim strip ---------- */
  @media (max-width: 1100px) {
    .cs {
      grid-template-columns: 196px minmax(0, 1fr) 40px;
    }
    .cs-peek {
      display: none;
    }
    .q-screens {
      display: flex;
      gap: 10px;
      grid-column: 1 / -1;
    }
    .q-screens img {
      width: 72px;
      height: auto;
      border-radius: 8px;
      box-shadow: 0 4px 12px rgba(17, 24, 39, 0.18);
    }
  }
  @media (max-width: 640px) {
    .cs {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 12px;
    }
    .cs-kpi {
      flex-direction: row;
      align-items: center;
      gap: 12px;
      min-height: 0;
      padding: 12px 14px;
    }
    .cs-kpi b {
      font-size: 28px;
      flex: none;
    }
    .cs-body {
      padding: 0 4px;
    }
    .cs-go {
      position: absolute;
      right: 14px;
      bottom: 12px;
      width: 36px;
      height: 36px;
    }
    /* Methods are secondary: hidden on phones to keep the rows short */
    .cs-methods {
      display: none;
    }
    .cs-item .cs-sum {
      padding-right: 44px;
    }
    .cs-quick-in {
      grid-template-columns: minmax(0, 1fr);
      margin: 0 6px;
    }
  }

  /* ---------- "Brewing new ideas" placeholder (logo purple) ---------- */
  .cs-brew {
    grid-template-columns: 196px minmax(0, 1fr);
    border-color: var(--pop-line);
    background: var(--pop-bg);
  }
  @media (max-width: 640px) {
    .cs-brew {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .brew-art {
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    background:
      radial-gradient(circle, rgba(169, 31, 189, 0.14) 1.1px, transparent 1.5px) 0 0 / 14px 14px,
      linear-gradient(135deg, #fbeffd, #f4ddf8);
  }
  @media (max-width: 640px) {
    .brew-art {
      justify-content: center;
      min-height: 96px;
    }
  }
  .flask {
    position: relative;
    display: block;
    width: 40px;
    height: 48px;
  }
  .flask img {
    position: relative;
    width: 40px;
    height: 48px;
    animation: sway 3.2s ease-in-out infinite;
    transform-origin: 50% 100%;
  }
  .bubble {
    position: absolute;
    left: calc(50% - 3px + (var(--b) - 3.5) * 2px);
    top: 2px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(169, 31, 189, 0.55);
    opacity: 0;
    animation: rise 2.8s ease-in infinite;
    animation-delay: calc(var(--b) * 0.35s);
  }
  .bubble:nth-child(3n + 2) {
    width: 8px;
    height: 8px;
  }
  .bubble:nth-child(4n + 1) {
    width: 4px;
    height: 4px;
  }
  .bubble:nth-child(3n) {
    background: transparent;
    border: 1.5px solid var(--pop);
  }
  .bubble:nth-child(4n) {
    background: rgba(126, 26, 168, 0.4);
  }
  .cs-brew:hover .bubble {
    animation-duration: 1.6s;
  }
  @keyframes rise {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(0.4);
    }
    15% {
      opacity: 1;
    }
    50% {
      transform: translate(calc((var(--b) - 3.5) * 2.5px), -30px) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(calc((var(--b) - 3.5) * -1.5px), -58px) scale(1.15);
    }
  }
  @keyframes sway {
    50% {
      transform: rotate(-4deg);
    }
  }
  .cs-brew .cs-title {
    color: var(--pop-deep);
  }
  .dots i {
    font-style: normal;
    animation: dot 1.4s infinite;
  }
  .dots i:nth-child(2) {
    animation-delay: 0.2s;
  }
  .dots i:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes dot {
    0%,
    60%,
    100% {
      opacity: 0.2;
    }
    30% {
      opacity: 1;
    }
  }
  /* Indeterminate "loading" bar */
  .brew-bar {
    position: relative;
    height: 6px;
    max-width: 360px;
    margin-top: 6px;
    border-radius: 6px;
    background: var(--pop-line);
    overflow: hidden;
  }
  .brew-bar span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--pop), var(--pop-deep));
    animation: load 1.8s ease-in-out infinite;
  }
  @keyframes load {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(260%);
    }
  }
</style>
